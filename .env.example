# Copy this file to .env and fill in the required secrets before running Compose.
# Required secret values are intentionally blank; Compose will reject them until set.
POSTGRES_USER=auth_service
POSTGRES_PASSWORD=

DB_USERNAME=auth_service_app
DB_PASSWORD=

AUTH_JWT_ISSUER=http://localhost:8081
AUTH_JWT_AUDIENCE=tenantguard-api
AUTH_JWT_KEY_ID=tenantguard-local
AUTH_JWT_ACCESS_TOKEN_TTL=PT10M

# Base64-encoded DER: PKCS#8 private key and X.509 SubjectPublicKeyInfo public key.
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=

# Local SMTP capture service in Docker Compose; production should use a real SMTP server.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@tenantguard.local
